# TraceStory Backend Environment Variables Example
# Duplicate this file to .env and configure actual values. Do NOT commit .env with real credentials.

# Database URL for SQLAlchemy connections.
# Use sqlite:///./tracestory.db for SQLite local development
# Use postgresql+psycopg://username:password@host:5432/database for PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/tracestory

# API key for AI summaries, classification, and RCA
GROQ_API_KEY=your_groq_api_key

# Allowed client origin(s) for CORS. Comma-separated list for multiple domains.
FRONTEND_ORIGIN=http://localhost:3000
